#include <Arduino.h>
#include <WiFi.h>
#include <time.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>

// OLED display setup
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64
#define OLED_RESET -1 // No reset pin
Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, OLED_RESET);

// WiFi credentials
const char* ssid = "LOTUSSCHOOL";
const char* password = "PASSWORD";

// Pin definitions
const int relayMotorPin = 26;  // Motor relay
const int relayValvePin = 27;  // Solenoid valve relay
const int flowSensorPin = 34;  // Water flow sensor
const int trigPin = 25;        // Ultrasonic trigger
const int echoPin = 33;        // Ultrasonic echo

// Flow sensor variables
volatile int flowPulseCount = 0;
float flowRate = 0.0;
unsigned long oldTime = 0;
const float calibrationFactor = 4.5; // Adjust based on sensor

// Time zone settings (adjust for your local time)
const long gmtOffset_sec = 19800;  // UTC+5:30 (e.g., India)
const int daylightOffset_sec = 0;  // No daylight saving

void setup() {
  Serial.begin(115200);

  // Initialize OLED display
  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println(F("SSD1306 allocation failed"));
    for (;;);
  }
  display.clearDisplay();
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(0, 0);
  display.println("Initializing...");
  display.display();

  // Initialize pins
  pinMode(relayMotorPin, OUTPUT);
  pinMode(relayValvePin, OUTPUT);
  pinMode(flowSensorPin, INPUT);
  pinMode(trigPin, OUTPUT);
  pinMode(echoPin, INPUT);

  // Set relays to OFF
  digitalWrite(relayMotorPin, LOW);
  digitalWrite(relayValvePin, LOW);

  // Attach interrupt for flow sensor
  attachInterrupt(digitalPinToInterrupt(flowSensorPin), flowPulseCounter, RISING);

  // Connect to WiFi
  display.println("Connecting WiFi...");
  display.display();
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(1000);
    Serial.println("Waiting for WiFi...");
  }
  Serial.println("WiFi Connected");
  display.clearDisplay();
  display.setCursor(0, 0);
  display.println("WiFi Connected");
  display.display();

  // Configure time
  configTime(gmtOffset_sec, daylightOffset_sec, "pool.ntp.org");
  while (!getLocalTime(&(struct tm){})) {
    delay(1000);
    Serial.println("Waiting for time...");
  }
  Serial.println("Time synced");
  display.println("Time Synced");
  display.display();
  delay(1000);
}

void loop() {
  // Get current time
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo)) {
    Serial.println("Failed to get time");
    delay(1000);
    return;
  }

  // Update OLED display
  display.clearDisplay();
  display.setCursor(0, 0);
  char timeStr[20];
  strftime(timeStr, sizeof(timeStr), "%H:%M:%S", &timeinfo);
  display.print("Time: ");
  display.println(timeStr);
  display.print("Level: ");
  display.print(measureDistance());
  display.println(" cm");
  display.print("Flow: ");
  display.print(flowRate);
  display.println(" L/min");
  display.print("Status: Idle");
  display.display();

  // Check for 5 AM trigger
  static int lastActionDay = -1;
  if (timeinfo.tm_hour >= 5 && timeinfo.tm_mday != lastActionDay) {
    Serial.println("Starting filling at 5 AM");
    lastActionDay = timeinfo.tm_mday;
    performFilling();
  }
  delay(1000);
}

void performFilling() {
  bool waterDetected = false;
  while (!waterDetected) {
    // Turn on motor and valve
    digitalWrite(relayMotorPin, HIGH);
    digitalWrite(relayValvePin, HIGH);
    Serial.println("Motor ON, Valve OPEN");

    // Update display
    display.clearDisplay();
    display.setCursor(0, 0);
    display.println("Filling Started");
    display.print("Level: ");
    display.print(measureDistance());
    display.println(" cm");
    display.print("Flow: ");
    display.print(flowRate);
    display.println(" L/min");
    display.println("Status: Filling");
    display.display();

    // Check flow for 30 seconds
    unsigned long startTime = millis();
    while (millis() - startTime < 30000) {
      calculateFlowRate();
      if (flowRate > 0) {
        waterDetected = true;
        break;
      }
      delay(1000);
    }

    if (!waterDetected) {
      digitalWrite(relayMotorPin, LOW);
      digitalWrite(relayValvePin, LOW);
      Serial.println("No water. Retrying in 5 min");

      // Update display
      display.clearDisplay();
      display.setCursor(0, 0);
      display.println("No Water Detected");
      display.println("Retrying in 5 min");
      display.display();
      delay(300000); // 5 minutes
    }
  }

  // Monitor tank level and flow
  Serial.println("Monitoring level and flow");
  unsigned long lastFlowTime = millis();
  while (true) {
    float distance = measureDistance();
    calculateFlowRate();

    // Update display
    display.clearDisplay();
    display.setCursor(0, 0);
    display.print("Level: ");
    display.print(distance);
    display.println(" cm");
    display.print("Flow: ");
    display.print(flowRate);
    display.println(" L/min");
    display.println("Status: Filling");
    display.display();

    // Check if tank is full (6 inches = 15.24 cm)
    if (distance < 15.24) {
      digitalWrite(relayMotorPin, LOW);
      digitalWrite(relayValvePin, LOW);
      Serial.println("Tank full");

      // Update display
      display.clearDisplay();
      display.setCursor(0, 0);
      display.println("Tank Full");
      display.println("Motor OFF");
      display.println("Valve CLOSED");
      display.display();
      break;
    }

    // Check for no flow
    if (flowRate > 0) {
      lastFlowTime = millis();
    } else if (millis() - lastFlowTime >= 30000) {
      digitalWrite(relayMotorPin, LOW);
      digitalWrite(relayValvePin, LOW);
      Serial.println("No flow for 30s");

      // Update display
      display.clearDisplay();
      display.setCursor(0, 0);
      display.println("No Flow 30s");
      display.println("Motor OFF");
      display.println("Valve CLOSED");
      display.display();
      break;
    }
    delay(1000);
  }
}

void calculateFlowRate() {
  if (millis() - oldTime > 1000) {
    detachInterrupt(digitalPinToInterrupt(flowSensorPin));
    flowRate = ((1000.0 / (millis() - oldTime)) * flowPulseCount) / calibrationFactor;
    oldTime = millis();
    flowPulseCount = 0;
    attachInterrupt(digitalPinToInterrupt(flowSensorPin), flowPulseCounter, RISING);
  }
}

float measureDistance() {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  long duration = pulseIn(echoPin, HIGH);
  return duration * 0.034 / 2;
}

void IRAM_ATTR flowPulseCounter() {
  flowPulseCount++;
}
