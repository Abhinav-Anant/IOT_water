// Configuration Constants
#define RADAR_RX 16
#define RADAR_TX 17
#define LORA_SCK 18
#define LORA_MISO 19
#define LORA_MOSI 23
#define LORA_SS 5
#define LORA_RST 25
#define LORA_DI0 26

// FIX: Validated LoRa parameters
#define LORA_FREQUENCY 915E6
#define LORA_BW 125E3
#define LORA_SF 7
#define LORA_CR 5
#define LORA_SYNC_WORD 0xF3
#define MAX_PACKET_SIZE 240

// FIX: Added watchdog timeout
#define WDT_TIMEOUT 30
#define INACTIVITY_TIMEOUT (5 * 60 * 1000)  // 5 minutes in milliseconds
#define MAX_RETRY_COUNT 3
#define STATIONARY_THRESHOLD 50
#define COOLDOWN_PERIOD 5000
#define SD_CLEANUP_THRESHOLD 90

// FIX: Changed to static buffers for reliability
static HardwareSerial radarSerial(2);
static bool targetDetected = false;
static unsigned long lastActivityTime = 0;
RTC_DATA_ATTR static int bootCount = 0;

