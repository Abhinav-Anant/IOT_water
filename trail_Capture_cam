namespace App {
    namespace Config {
        // Hardware pin configuration
        constexpr uint8_t RADAR_RX = 16;
        constexpr uint8_t RADAR_TX = 17;
        
        // LoRa parameters (FCC compliant)
        constexpr uint8_t LORA_SCK = 18;
        constexpr uint8_t LORA_MISO = 19;
        constexpr uint8_t LORA_MOSI = 23;
        constexpr uint8_t LORA_SS = 5;
        constexpr uint8_t LORA_RST = 25;
        constexpr uint8_t LORA_DI0 = 26;
        constexpr long LORA_FREQ = 915E6;
        constexpr uint8_t LORA_SF = 7;
        constexpr uint8_t LORA_CR = 5;
        constexpr uint8_t LORA_BW = 125E3;
        constexpr uint8_t LORA_SYNC_WORD = 0xF3;

        // System timing constants
        constexpr uint32_t WDT_TIMEOUT = 30;         // Watchdog timeout (seconds)
        constexpr uint32_t INACTIVITY_TIMEOUT = 5*60*1000; // 5 minutes
        constexpr uint16_t RADAR_TIMEOUT = 100;      // 100ms packet timeout
        constexpr uint16_t COOLDOWN_PERIOD = 5000;   // 5 seconds
        constexpr uint8_t MAX_RETRIES = 3;
        constexpr uint16_t STATIONARY_THRESHOLD = 50;
    }

    // Shared system state
    namespace State {
        bool targetDetected = false;
        unsigned long lastActivity = 0;
        RTC_DATA_ATTR int bootCount = 0;
        
        struct {
            bool sdCardInitialized : 1;
            bool cameraInitialized : 1;
            bool loraInitialized : 1;
            bool radarInitialized : 1;
        } status;
    }
}

// --------------------------------------------------
// Error Handling Subsystem
// --------------------------------------------------
namespace Error {
    enum class Code : uint8_t {
        None = 0,
        CameraInit,
        SDCardMount,
        LoRaInit,
        RadarTimeout,
        ImageCapture,
        LoRaTx,
        FileSystem,
        SystemHealth
    };

    struct Record {
        uint32_t timestamp;
        Code code;
        char context[48];
    };

    void log(Code code, const char* context = "") {
        Record err {
            .timestamp = millis(),
            .code = code,
        };
        strlcpy(err.context, context, sizeof(err.context));
        
        if(SD_MMC.exists("/errors.log")) {
            File log = SD_MMC.open("/errors.log", FILE_APPEND);
            if(log) {
                log.write(reinterpret_cast<uint8_t*>(&err), sizeof(err));
                log.close();
            }
        }
    }
}

// --------------------------------------------------
// Hardware Initialization
// --------------------------------------------------
bool initCamera() {
    camera_config_t config;
    // Camera interface pins
    config.pin_d0 = 5;   // Y2_GPIO_NUM
    config.pin_d1 = 18;  // Y3_GPIO_NUM
    config.pin_d2 = 19;  // Y4_GPIO_NUM
    config.pin_d3 = 21;  // Y5_GPIO_NUM
    config.pin_d4 = 36;  // Y6_GPIO_NUM
    config.pin_d5 = 39;  // Y7_GPIO_NUM
    config.pin_d6 = 34;  // Y8_GPIO_NUM
    config.pin_d7 = 35;  // Y9_GPIO_NUM
    config.pin_xclk = 0;
    config.pin_pclk = 22;
    config.pin_vsync = 25;
    config.pin_href = 23;
    config.pin_sccb_sda = 26;
    config.pin_sccb_scl = 27;
    config.pin_pwdn = 32;
    config.pin_reset = -1; // Shared with LED FLASH
    
    // Camera settings
    config.xclk_freq_hz = 20000000;  // 20MHz
    config.ledc_channel = LEDC_CHANNEL_0;
    config.ledc_timer = LEDC_TIMER_0;
    config.pixel_format = PIXFORMAT_JPEG;
    config.frame_size = FRAMESIZE_UXGA;  // 1600x1200
    config.jpeg_quality = 12;  // 0-63 (higher = better)
    config.fb_count = 2;  // Double buffer
    
    esp_err_t ret = esp_camera_init(&config);
    if(ret != ESP_OK) {
        Error::log(Error::Code::CameraInit, "Init failed");
        return false;
    }

bool initLoRa() {
    LoRa.setPins(App::Config::LORA_SS, 
                App::Config::LORA_RST, 
                App::Config::LORA_DI0);
                
    if(!LoRa.begin(App::Config::LORA_FREQ)) {
        Error::log(Error::Code::LoRaInit, "Begin failed");
        return false;
    }

    LoRa.setSpreadingFactor(App::Config::LORA_SF);
    LoRa.setSignalBandwidth(App::Config::LORA_BW);
    LoRa.setCodingRate4(App::Config::LORA_CR);
    LoRa.setSyncWord(App::Config::LORA_SYNC_WORD);
    return true;
}

// --------------------------------------------------
// Radar Processing
// --------------------------------------------------
namespace Radar {
    struct Packet {
        uint8_t header[2];
        uint16_t moving;
        uint16_t stationary;
        uint8_t checksum;
    };

    bool validatePacket(const uint8_t* data) {
        // Improved checksum validation
        uint8_t sum = 0;
        for(int i=0; i<23; i++) sum += data[i];
        return (sum == data[23]);
    }

    void process() {
        static uint8_t buffer[24];
        static uint8_t index = 0;
        static uint32_t lastByteTime = 0;

        while(radarSerial.available()) {
            uint32_t now = millis();
            
            // Timeout handling
            if(now - lastByteTime > App::Config::RADAR_TIMEOUT) {
                index = 0;
                Error::log(Error::Code::RadarTimeout, "Packet timeout");
            }

            buffer[index++] = radarSerial.read();
            lastByteTime = now;

            if(index >= sizeof(buffer)) {
                index = 0;
                if(validatePacket(buffer)) {
                    Packet pkt = *reinterpret_cast<Packet*>(buffer);
                    App::State::targetDetected = 
                        (pkt.moving > 0) || 
                        (pkt.stationary > App::Config::STATIONARY_THRESHOLD);
                }
            }
        }
    }
}

// --------------------------------------------------
// Image Management
// --------------------------------------------------
namespace ImageSystem {
    bool captureAndSave(String& filename) {
        camera_fb_t* fb = esp_camera_fb_get();
        if(!fb || fb->format != PIXFORMAT_JPEG) {
            Error::log(Error::Code::ImageCapture, "Capture failed");
            return false;
        }

        filename = String("/img/") + esp_timer_get_time() + ".jpg";
        File file = SD_MMC.open(filename.c_str(), FILE_WRITE);
        
        if(!file || file.write(fb->buf, fb->len) != fb->len) {
            Error::log(Error::Code::FileSystem, "Write failed");
            file.close();
            esp_camera_fb_return(fb);
            return false;
        }

        file.close();
        esp_camera_fb_return(fb);
        return true;
    }

    void manageStorage() {
        constexpr uint64_t MAX_STORAGE = 90'000'000; // 90MB
        if(SD_MMC.usedBytes() > MAX_STORAGE) {
            File root = SD_MMC.open("/img");
            File file = root.openNextFile();
            
            // Delete oldest file
            if(file && !file.isDirectory()) {
                SD_MMC.remove(file.path());
            }
        }
    }
}

// --------------------------------------------------
// LoRa Communication
// --------------------------------------------------
namespace LoRaTx {
    bool sendImage(const String& filename) {
        File imgFile = SD_MMC.open(filename.c_str());
        if(!imgFile) {
            Error::log(Error::Code::FileSystem, "Open failed");
            return false;
        }

        constexpr size_t CHUNK_SIZE = 220; // LoRa max payload
        uint8_t buffer[CHUNK_SIZE];
        size_t bytesRead;
        uint16_t packetCount = 0;

        do {
            bytesRead = imgFile.read(buffer, CHUNK_SIZE);
            if(bytesRead > 0) {
                LoRa.beginPacket();
                LoRa.write(buffer, bytesRead);
                if(!LoRa.endPacket()) {
                    Error::log(Error::Code::LoRaTx, "Packet failed");
                    imgFile.close();
                    return false;
                }
                packetCount++;
            }
        } while(bytesRead == CHUNK_SIZE);

        imgFile.close();
        return true;
    }
}

// --------------------------------------------------
// Power Management
// --------------------------------------------------
namespace Power {
    void deepSleep() {
        esp_camera_deinit();
        SD_MMC.end();
        LoRa.end();
        radarSerial.end();
        
        // Isolate GPIOs
        rtc_gpio_isolate(GPIO_NUM_16);
        rtc_gpio_isolate(GPIO_NUM_17);
        
        esp_deep_sleep(App::Config::INACTIVITY_TIMEOUT * 1000);
    }

    void checkWatchdog() {
        if(millis() - App::State::lastActivity > App::Config::WDT_TIMEOUT * 1000) {
            ESP.restart();
        }
    }
}

// --------------------------------------------------
// Main Application
// --------------------------------------------------
void setup() {
    esp_task_wdt_init(App::Config::WDT_TIMEOUT, true);
    Serial.begin(115200);
    
    // Boot count management
    if(App::State::bootCount++ > 3) {
        Power::deepSleep();
    }

    // Hardware initialization
    App::State::status = {
        .sdCardInitialized = SD_MMC.begin("/sdcard", true),
        .cameraInitialized = initCamera(),
        .loraInitialized = initLoRa(),
        .radarInitialized = radarSerial.begin(256000, SERIAL_8N1, 
                                            App::Config::RADAR_RX,
                                            App::Config::RADAR_TX)
    };

    // Validate critical systems
    if(!App::State::status.sdCardInitialized || 
       !App::State::status.cameraInitialized) {
        delay(5000);
        ESP.restart();
    }
}

void loop() {
    esp_task_wdt_reset();
    
    // Main processing flow
    Radar::process();
    ImageSystem::manageStorage();
    
    if(App::State::targetDetected) {
        String filename;
        if(ImageSystem::captureAndSave(filename)) {
            if(LoRaTx::sendImage(filename)) {
                App::State::lastActivity = millis();
            }
        }
        App::State::targetDetected = false;
    }

    // Power management
    if(millis() - App::State::lastActivity > App::Config::INACTIVITY_TIMEOUT) {
        Power::deepSleep();
    }
    
    Power::checkWatchdog();
}
