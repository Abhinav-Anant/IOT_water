// Error handling structure
struct ErrorLog {
    uint32_t timestamp;
    uint8_t errorCode;
    char message[64];
};

// Error codes
enum ErrorCodes {
    ERR_NONE = 0,
    ERR_CAMERA_INIT = 1,
    ERR_SD_CARD = 2,
    ERR_LORA_INIT = 3,
    ERR_RADAR_TIMEOUT = 4,
    ERR_IMAGE_CAPTURE = 5,
    ERR_TRANSMISSION = 6
};

void logError(uint8_t errorCode, const char* message) {
    ErrorLog error = {
        .timestamp = millis(),
        .errorCode = errorCode
    };
    strncpy(error.message, message, sizeof(error.message) - 1);
    
    File errorLog = SD_MMC.open("/error_log.txt", FILE_APPEND);
    if (errorLog) {
        errorLog.printf("%lu,%d,%s\n", error.timestamp, error.errorCode, error.message);
        errorLog.close();
    }
}

// System Diagnostics Structure
struct SystemDiagnostics {
    uint32_t freeHeap;
    uint32_t minFreeHeap;
    float cpuTemperature;
    uint64_t uptime;
    uint32_t sdCardSpace;
    uint16_t batteryVoltage;
    uint8_t wifiStrength;
    uint8_t loraRSSI;
};

// Diagnostics Function
SystemDiagnostics getDiagnostics() {
    SystemDiagnostics diag;
    diag.freeHeap = esp_get_free_heap_size();
    diag.minFreeHeap = esp_get_minimum_free_heap_size();
    diag.cpuTemperature = temperatureRead();
    diag.uptime = esp_timer_get_time() / 1000000ULL; // Convert to seconds
    diag.sdCardSpace = (SD_MMC.totalBytes() - SD_MMC.usedBytes()) / 1024; // KB
    diag.batteryVoltage = analogRead(BATTERY_PIN) * 2 * 3.3 / 4095; // Assuming voltage divider
    diag.loraRSSI = LoRa.packetRssi();
    
    return diag;
}

// Add diagnostic logging
void logDiagnostics() {
    static unsigned long lastDiagnosticLog = 0;
    const unsigned long DIAGNOSTIC_INTERVAL = 60000; // 1 minute
    
    if (millis() - lastDiagnosticLog >= DIAGNOSTIC_INTERVAL) {
        SystemDiagnostics diag = getDiagnostics();
        
        File logFile = SD_MMC.open("/system_log.txt", FILE_APPEND);
        if (logFile) {
            logFile.printf("%lu,%.2f,%u,%u,%d,%d\n",
                          diag.uptime,
                          diag.cpuTemperature,
                          diag.freeHeap,
                          diag.sdCardSpace,
                          diag.batteryVoltage,
                          diag.loraRSSI);
            logFile.close();
        }
        lastDiagnosticLog = millis();
    }
}

// --------------------------------------------------
// Hardware Initialization
// --------------------------------------------------
bool initCamera() {
    camera_config_t config;
    // ... (camera configuration)
    return esp_camera_init(&config) == ESP_OK;
}

bool initLoRa() {
    LoRa.setPins(LORA_SS, LORA_RST, LORA_DI0);
    if (!LoRa.begin(LORA_FREQUENCY)) return false;
    
    // FIX: Validated LoRa settings
    LoRa.setSpreadingFactor(LORA_SF);
    LoRa.setSignalBandwidth(LORA_BW);
    LoRa.setCodingRate4(LORA_CR);
    LoRa.setSyncWord(LORA_SYNC_WORD);
    return true;
}

// --------------------------------------------------
// Power Management
// --------------------------------------------------
void shutdownPeripherals() {
    // FIX: Proper hardware deinitialization
    esp_camera_deinit();
    SD_MMC.end();
    LoRa.end();
    radarSerial.end();
    rtc_gpio_isolate(GPIO_NUM_16);
    rtc_gpio_isolate(GPIO_NUM_17);
}

// --------------------------------------------------
// File Management
// --------------------------------------------------
bool capture_and_save(char* filename) {
    camera_fb_t *fb = esp_camera_fb_get();
    if (!fb) return false;

    // FIX: Static filename buffer
    static char fn[32];
    snprintf(fn, sizeof(fn), "/img_%llu.jpg", esp_timer_get_time());
    
    File file = SD_MMC.open(fn, FILE_WRITE);
    if (!file || file.write(fb->buf, fb->len) != fb->len) {
        file.close();
        esp_camera_fb_return(fb);
        return false;
    }
    
    // FIX: Ensure write completion
    file.sync();
    file.close();
    esp_camera_fb_return(fb);
    
    strncpy(filename, fn, 32);
    return true;
}

// FIX: Optimized SD cleanup using timestamp tracking
void cleanupSDCard() {
    if (!SD_MMC.totalBytes()) {
        Serial.println("Failed to get SD card size");
        return;
    }

    uint64_t totalBytes = SD_MMC.totalBytes();
    uint64_t usedBytes = SD_MMC.usedBytes();
    float usage = (float)usedBytes / totalBytes * 100;

    Serial.printf("SD Card Usage: %.1f%%\n", usage);

    if (usage > 90) {  // Cleanup threshold
        File root = SD_MMC.open("/");
        if (!root || !root.isDirectory()) {
            Serial.println("Failed to open root directory");
            return;
        }

        String oldestFile;
        unsigned long oldestTime = ULONG_MAX;

        File file = root.openNextFile();
        while (file) {
            if (!file.isDirectory()) {
                unsigned long fileTime = file.getLastWrite();
                if (fileTime < oldestTime) {
                    oldestTime = fileTime;
                    oldestFile = String(file.name());
                }
            }
            file = root.openNextFile();
        }

        if (!oldestFile.isEmpty()) {
            if (SD_MMC.remove(oldestFile.c_str())) {
                Serial.printf("Removed old file: %s\n", oldestFile.c_str());
            } else {
                Serial.println("Failed to remove file");
            }
        }
        root.close();
    }
}

// --------------------------------------------------
// Radar Processing
// --------------------------------------------------
void check_radar() {
    static uint8_t radar_buffer[24];
    static uint8_t buf_index = 0;
    static unsigned long lastByteTime = 0;
    static const uint16_t RADAR_TIMEOUT = 100;  // 100ms timeout

    while (radarSerial.available()) {
        unsigned long currentTime = millis();
        if (currentTime - lastByteTime > RADAR_TIMEOUT) {
            buf_index = 0;
            Serial.println("Radar timeout - resetting buffer");
        }
        lastByteTime = currentTime;

        radar_buffer[buf_index] = radarSerial.read();

        // Improved header validation
        if (buf_index == 0) {
            if (radar_buffer[0] != 0xAA) {
                Serial.println("Invalid header byte 1");
                continue;
            }
        }
        if (buf_index == 1) {
            if (radar_buffer[1] != 0xFF) {
                Serial.println("Invalid header byte 2");
                buf_index = 0;
                continue;
            }
        }

        if (++buf_index >= 24) {
            buf_index = 0;
            if (validateRadarPacket(radar_buffer)) {
                processRadarData(radar_buffer);
            }
        }
    }
}

bool validateRadarPacket(const uint8_t* buffer) {
    if (buffer[0] != 0xAA || buffer[1] != 0xFF) {
        Serial.println("Invalid packet header");
        return false;
    }
    
    // Add checksum validation if applicable
    return true;
}

void processRadarData(const uint8_t* buffer) {
    uint16_t moving = (buffer[9] << 8) | buffer[10];
    uint16_t stationary = (buffer[11] << 8) | buffer[12];
    
    Serial.printf("Moving: %d, Stationary: %d\n", moving, stationary);
    targetDetected = (moving > 0 || stationary > STATIONARY_THRESHOLD);
}

// --------------------------------------------------
// LoRa Transmission
// --------------------------------------------------
bool sendLoRaPacket(const uint8_t* data, size_t len) {
    for (int retry = 0; retry < MAX_RETRY_COUNT; retry++) {
        LoRa.beginPacket();
        LoRa.write(data, len);
        if (LoRa.endPacket()) {
            // FIX: Use actual airtime calculation
            delay(LoRa.getTimeOnAir(len) / 1000);
            return true;
        }
        delay(100 + random(50));
    }
    return false;
}

// --------------------------------------------------
// Main Application Logic
// --------------------------------------------------
void setup() {
    esp_task_wdt_init(WDT_TIMEOUT, true);
    Serial.begin(115200);
    
    // FIX: Boot loop prevention
    if (bootCount++ > 3) {
        esp_deep_sleep(60e6);
    }

    status = {
        .sdCardOk = SD_MMC.begin("/sdcard", true),
        .cameraOk = initCamera(),
        .loraOk = initLoRa(),
        .radarOk = radarSerial.begin(256000, SERIAL_8N1, RADAR_RX, RADAR_TX)
    };

    if (!status.sdCardOk || !status.cameraOk || !status.loraOk) {
        delay(5000);  // Prevent boot loops
        ESP.restart();
    }
}

void loop() {
    esp_task_wdt_reset();
    
    // System diagnostics
    logDiagnostics();
    
    // Check system health
    if (!checkSystemHealth()) {
        logError(ERR_SYSTEM_HEALTH, "Critical system health check failed");
        shutdownPeripherals();
        esp_deep_sleep_start();
    }
    
    // Check radar with error handling
    if (!check_radar()) {
        logError(ERR_RADAR_TIMEOUT, "Radar communication timeout");
    }

    if (targetDetected) {
        char filename[32];
        if (capture_and_save(filename)) {
            if (!transmit_image(filename)) {
                logError(ERR_TRANSMISSION, "Failed to transmit image");
            }
            targetDetected = false;
            lastActivityTime = millis();
        } else {
            logError(ERR_IMAGE_CAPTURE, "Failed to capture or save image");
        }
    }

    // Power management
    if (millis() - lastActivityTime > INACTIVITY_TIMEOUT) {
        logDiagnostics(); // Final diagnostics before sleep
        shutdownPeripherals();
        esp_deep_sleep_start();
    }
}
